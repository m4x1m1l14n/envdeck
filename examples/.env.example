# Acme API — environment schema.

# Runtime environment
# @required @type=enum(development, staging, production)
NODE_ENV=development

# @optional @type=enum(debug, info, warn, error)
LOG_LEVEL=info

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# @group Server
# HTTP server settings
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Port the API listens on
# @required @type=port
PORT=3000

# Public base URL used in emails and redirects
# @required @type=url(protocols="http,https") @example=https://api.acme.dev
PUBLIC_URL=http://localhost:3000

# @optional @type=integer(min=1, max=64)
WORKER_COUNT=4

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# @group Database
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Primary Postgres connection string
# @required @sensitive @type=url(protocols="postgres,postgresql")
DATABASE_URL=

# Connection pool size
# @optional @type=integer(min=1, max=100)
DB_POOL_SIZE=10

# @optional @type=boolean
DB_SSL=false

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# @group Auth
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Secret used to sign JWTs. Generate with: openssl rand -hex 32
# @required @sensitive @type=string(minLength=64, maxLength=64, pattern="^[a-f0-9]+$")
JWT_SECRET=

# Token lifetime in seconds
# @optional @type=integer(min=60, max=86400)
JWT_TTL=3600

# @optional @type=email @example=admin@acme.dev
ADMIN_EMAIL=
