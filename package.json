{
  "name": "envdeck",
  "version": "0.1.0",
  "description": "Schema-driven .env management: design .env.example, fill .env files, and audit drift across environments.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "envdeck": "./dist-cli/envdeck.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:cli": "tsup",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "cli": "node dist-cli/envdeck.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "dotenv",
    "env",
    "environment-variables",
    "schema",
    "validation",
    "config",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/m4x1m1l14n/envdeck.git"
  },
  "author": "m4x1m1l14n (https://github.com/m4x1m1l14n)",
  "private": true
}
